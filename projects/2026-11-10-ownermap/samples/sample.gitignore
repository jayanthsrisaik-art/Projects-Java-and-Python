# build output anywhere
build/
*.log
!keep.log
# only the top-level dist, and everything below it
/dist/**
# re-including inside an ignored directory does not work in git
logs/
!logs/important.txt
# a ** that touches a literal prefix (git < 2.52 also matched the directory "out"; 2.52+ does not)
out**/**
[Tt]emp/
\#notes.md
