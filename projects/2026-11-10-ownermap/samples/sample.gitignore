# build output anywhere
build/
*.log
!keep.log
# only the top-level dist, and everything below it
/dist/**
# re-including inside an ignored directory does not work in git
logs/
!logs/important.txt
# ** glued to a literal prefix: ignores what is below out*/ (older git, e.g. 2.43, also ignored "out" itself)
out**/**
[Tt]emp/
\#notes.md
